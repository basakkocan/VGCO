@prefix : <https://github.com/basakkocan/VGCO/ontology/vgco#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://github.com/basakkocan/VGCO/ontology/vgco#> .

<https://github.com/basakkocan/VGCO/ontology/vgco#> rdf:type owl:Ontology ;
                                                     <http://purl.org/dc/terms/abstract> "The Video Game Catalog Ontology (VGCO) provides a structured knowledge model for describing and querying video games and their associated metadata. The knowledge graph is populated using the RAWG Video Games Database API, capturing key entities such as titles, release dates, metacritic scores, and media assets. By utilizing BFO-based namespaces, the ontology ensures interoperability with broader scientific and entertainment knowledge models."@en ;
                                                     <http://purl.org/dc/terms/creator> "Başak Koçan"@en ,
                                                                                        "Gürkan İsmet Arslan"@en ,
                                                                                        "Tarık Aydın"@en ,
                                                                                        "Utku Emre Doğanbaş"@en ;
                                                     <http://purl.org/dc/terms/description> "The focus of the ontology is the VideoGame as a central entity and its direct metadata relationships. The ontology captures essential information about games, including their genres, platforms, developers, publishers, and media assets. This structured model enables complex querying based on criteria such as review scores, Metacritic ratings, or franchise membership, bridging the gap between high-level conceptual schemas and large-scale instance data."@en ;
                                                     <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                                     <http://purl.org/dc/terms/title> "Video Game Catalog Ontology (VGCO)"@en ;
                                                     <http://purl.org/vocab/vann/preferredNamespacePrefix> "vgco" ;
                                                     <http://purl.org/vocab/vann/preferredNamespaceUri> "https://github.com/basakkocan/VGCO/ontology/vgco/" ;
                                                     owl:versionInfo "1.0" .


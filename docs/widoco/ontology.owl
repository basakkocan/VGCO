<?xml version="1.0"?>
<rdf:RDF xmlns="https://github.com/basakkocan/VGCO/ontology/vgco#"
     xml:base="https://github.com/basakkocan/VGCO/ontology/vgco"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:BFO_0000030="http://purl.obolibrary.org/obo/BFO_0000030#">
    <owl:Ontology rdf:about="https://github.com/basakkocan/VGCO/ontology/vgco#">
        <terms:abstract xml:lang="en">The Video Game Catalog Ontology (VGCO) provides a structured knowledge model for describing and querying video games and their associated metadata. The knowledge graph is populated using the RAWG Video Games Database API, capturing key entities such as titles, release dates, metacritic scores, and media assets. By utilizing BFO-based namespaces, the ontology ensures interoperability with broader scientific and entertainment knowledge models.</terms:abstract>
        <terms:creator xml:lang="en">Başak Koçan</terms:creator>
        <terms:creator xml:lang="en">Gürkan İsmet Arslan</terms:creator>
        <terms:creator xml:lang="en">Tarık Aydın</terms:creator>
        <terms:creator xml:lang="en">Utku Emre Doğanbaş</terms:creator>
        <terms:description xml:lang="en">The focus of the ontology is the VideoGame as a central entity and its direct metadata relationships. The ontology captures essential information about games, including their genres, platforms, developers, publishers, and media assets. This structured model enables complex querying based on criteria such as review scores, Metacritic ratings, or franchise membership, bridging the gap between high-level conceptual schemas and large-scale instance data.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:title xml:lang="en">Video Game Catalog Ontology (VGCO)</terms:title>
        <vann:preferredNamespacePrefix>vgco</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://github.com/basakkocan/VGCO/ontology/vgco/</vann:preferredNamespaceUri>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>
    



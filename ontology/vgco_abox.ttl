bfo:unpacking_2 a bfo:VideoGame ;
    bfo:availableOn bfo:Linux,
        bfo:Macos,
        bfo:Nintendo_Switch,
        bfo:Pc,
        bfo:Playstation4,
        bfo:Playstation5,

        bfo:Family_Friendly,
        bfo:Kids,
        bfo:Local_Multiplayer,
        bfo:Singleplayer,
        bfo:True_Exclusive ;
    bfo:metacriticScore 97 ;
    bfo:officialWebsite "https://www.nintendo.com/games/detail/super-mario-odyssey-switch"^^xsd:anyURI ;
    bfo:publishedBy bfo:Nintendo ;

bfo:disco_elysium a bfo:VideoGame ;
    bfo:availableOn bfo:Macos,
        bfo:Nintendo_Switch,
        bfo:Pc,
        bfo:Playstation4,
        bfo:Playstation5,
        bfo:Xbox_One,

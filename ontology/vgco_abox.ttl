        bfo:Puzzles,
        bfo:Tetris,
        bfo:Vivid ;
    bfo:metacriticScore 90 ;
    bfo:officialWebsite "https://www.tetriseffect.game/"^^xsd:anyURI ;
    bfo:rating 4.36 ;
